# Application Settings
APP_NAME="Golang-MVC-API"
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080

# Database Configuration
# Supported drivers: sqlite, postgres, mysql
DB_DRIVER=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=golang_template_db
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Kolkata
# For SQLite only (path to file)
DB_SQLITE_PATH=./app.db

# JWT Configuration
JWT_SECRET=supersecretjwtkeythatshouldbechangedinproduction1234567890
JWT_EXPIRATION_HOURS=72

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
